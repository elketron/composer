 };
 
+imports the webview's current DMA-BUF frame as an EGLImage on the EGL
+// display that is current here (Flutter's). The EGLImage the plugin creates on WPE's own
+// display can't be bound in Flutter's context on Mesa, which leaves the view blank.
+static gboolean import_frame_on_current_display(InAppWebViewEGLTexture* self) {
+  if (self->webview == nullptr || self->own_import_failed) {
+    return FALSE;
+  }
+  uint32_t fourcc = 0, width = 0, height = 0, n_planes = 0;
+  uint64_t modifier = 0, serial = 0;
+  int fds[4];
+  uint32_t offsets[4], strides[4];
+  if (!self->webview->GetCurrentDmaBuf(&fourcc, &modifier, &width, &height, &n_planes, fds,
+                                       offsets, strides, &serial)) {
+    return FALSE;
+  }
+  if (serial == self->own_serial && self->own_image != EGL_NO_IMAGE_KHR) {
+    return TRUE;  // this frame is already imported
+  }
+  EGLDisplay display = eglGetCurrentDisplay();
+  if (display == EGL_NO_DISPLAY) {
+    return FALSE;
+  }
+
+  static const EGLint fd_keys[4] = {EGL_DMA_BUF_PLANE0_FD_EXT, EGL_DMA_BUF_PLANE1_FD_EXT,
+                                    EGL_DMA_BUF_PLANE2_FD_EXT, EGL_DMA_BUF_PLANE3_FD_EXT};
+  static const EGLint offset_keys[4] = {EGL_DMA_BUF_PLANE0_OFFSET_EXT, EGL_DMA_BUF_PLANE1_OFFSET_EXT,
+                                        EGL_DMA_BUF_PLANE2_OFFSET_EXT, EGL_DMA_BUF_PLANE3_OFFSET_EXT};
+  static const EGLint pitch_keys[4] = {EGL_DMA_BUF_PLANE0_PITCH_EXT, EGL_DMA_BUF_PLANE1_PITCH_EXT,
+                                       EGL_DMA_BUF_PLANE2_PITCH_EXT, EGL_DMA_BUF_PLANE3_PITCH_EXT};
+  static const EGLint mod_lo_keys[4] = {EGL_DMA_BUF_PLANE0_MODIFIER_LO_EXT, EGL_DMA_BUF_PLANE1_MODIFIER_LO_EXT,
+                                        EGL_DMA_BUF_PLANE2_MODIFIER_LO_EXT, EGL_DMA_BUF_PLANE3_MODIFIER_LO_EXT};
+  static const EGLint mod_hi_keys[4] = {EGL_DMA_BUF_PLANE0_MODIFIER_HI_EXT, EGL_DMA_BUF_PLANE1_MODIFIER_HI_EXT,
+                                        EGL_DMA_BUF_PLANE2_MODIFIER_HI_EXT, EGL_DMA_BUF_PLANE3_MODIFIER_HI_EXT};
+  const uint64_t invalid_modifier = 0x00ffffffffffffffULL;  // DRM_FORMAT_MOD_INVALID
+
+  EGLint attribs[64];
+  int i = 0;
+  attribs[i++] = EGL_WIDTH;
+  attribs[i++] = static_cast<EGLint>(width);
+  attribs[i++] = EGL_HEIGHT;
+  attribs[i++] = static_cast<EGLint>(height);
+  attribs[i++] = EGL_LINUX_DRM_FOURCC_EXT;
+  attribs[i++] = static_cast<EGLint>(fourcc);
+  for (uint32_t p = 0; p < n_planes; p++) {
+    attribs[i++] = fd_keys[p];
+    attribs[i++] = fds[p];
+    attribs[i++] = offset_keys[p];
+    attribs[i++] = static_cast<EGLint>(offsets[p]);
+    attribs[i++] = pitch_keys[p];
+    attribs[i++] = static_cast<EGLint>(strides[p]);
+    if (modifier != invalid_modifier) {
+      attribs[i++] = mod_lo_keys[p];
+      attribs[i++] = static_cast<EGLint>(modifier & 0xffffffff);
+      attribs[i++] = mod_hi_keys[p];
+      attribs[i++] = static_cast<EGLint>(modifier >> 32);
+    }
+  }
+  attribs[i++] = EGL_NONE;
+
+  EGLImageKHR image = eglCreateImageKHR(display, EGL_NO_CONTEXT, EGL_LINUX_DMA_BUF_EXT, nullptr, attribs);
+  if (image == EGL_NO_IMAGE_KHR) {
+    flutter_inappwebview_plugin::errorLog(
+        "InAppWebViewEGLTexture: DMA-BUF import on Flutter's display failed, EGL error " +
+        std::to_string(eglGetError()) + "; falling back");
+    self->own_import_failed = TRUE;
+    return FALSE;
+  }
+  if (self->own_image != EGL_NO_IMAGE_KHR) {
+    eglDestroyImageKHR(self->own_display, self->own_image);
+  }
+  static bool logged = false;
+  if (!logged) {
+    flutter_inappwebview_plugin::debugLog(
+        "InAppWebViewEGLTexture: importing frames on Flutter's EGL display");
+    logged = true;
+  }
+  self->own_image = image;
+  self->own_display = display;
+  self->own_serial = serial;
+  self->width = width;
+  self->height = height;
+  return TRUE;
+}
