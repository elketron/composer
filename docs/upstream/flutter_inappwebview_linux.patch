+bool InAppWebView::GetCurrentDmaBuf(uint32_t* fourcc, uint64_t* modifier, uint32_t* width,
+                                    uint32_t* height, uint32_t* n_planes, int fds[4],
+                                    uint32_t offsets[4], uint32_t strides[4],
+                                    uint64_t* serial) const {
+#ifdef HAVE_WPE_PLATFORM
+  std::lock_guard<std::mutex> lock(wpe_buffer_mutex_);
+  if (current_buffer_ == nullptr || !WPE_IS_BUFFER_DMA_BUF(current_buffer_)) {
+    return false;
+  }
+  WPEBufferDMABuf* dmabuf = WPE_BUFFER_DMA_BUF(current_buffer_);
+  uint32_t planes = wpe_buffer_dma_buf_get_n_planes(dmabuf);
+  if (planes == 0 || planes > 4) {
+    return false;
+  }
+  *fourcc = wpe_buffer_dma_buf_get_format(dmabuf);
+  *modifier = wpe_buffer_dma_buf_get_modifier(dmabuf);
+  *width = static_cast<uint32_t>(wpe_buffer_get_width(current_buffer_));
+  *height = static_cast<uint32_t>(wpe_buffer_get_height(current_buffer_));
+  *n_planes = planes;
+  for (uint32_t i = 0; i < planes; i++) {
+    fds[i] = wpe_buffer_dma_buf_get_fd(dmabuf, i);
+    offsets[i] = wpe_buffer_dma_buf_get_offset(dmabuf, i);
+    strides[i] = wpe_buffer_dma_buf_get_stride(dmabuf, i);
+  }
+  *serial = current_buffer_serial_;
+  return true;
+#else
+  return false;
+#endif
+}
 
